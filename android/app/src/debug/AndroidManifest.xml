<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug only: lets a handset on the office Wi-Fi reach the laptop's API over plain
         http://<LAN IP>:8016. Android 9+ refuses cleartext otherwise and the app just says
         "Could not reach UKO". Release builds keep the default (HTTPS only). -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
